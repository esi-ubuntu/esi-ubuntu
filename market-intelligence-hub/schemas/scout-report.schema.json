{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mih.local/schemas/scout-report.schema.json",
  "$comment":"Runtime invariants are additionally enforced by scripts/lib/validation.mjs",
  "x-schema-version":"1.0",
  "type":"object",
  "required":["schema_version","report_id","market","generated_at","agent","market_status","candidates","top_5","data_quality"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "report_id":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}-IR-TSE-1200$"},
    "market":{"const":"iran_stock"},
    "generated_at":{"type":"string"},
    "data_quality":{"type":"object"},
    "agent":{"type":"object"},
    "market_status":{"type":"object"},
    "candidates":{"type":"array","maxItems":10},
    "top_5":{"type":"array","maxItems":5},
    "best_early_candidate":{},"best_momentum_hunter":{},"best_potential_prime":{}
  },
  "additionalProperties":false
}
