# Copy to deploy/.env on the isolated target and fill secrets locally.
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
INVESTIGATOR_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE
INVESTIGATOR_IMAGE_TAG=REPLACE_WITH_BUILD_GIT_SHA

# Existing organization services. No write privileges are required or permitted.
ES_URL=https://elasticsearch.example.internal:9200
ES_API_KEY=REPLACE_WITH_READ_ONLY_API_KEY
ES_SSL_SKIP_VERIFY=false
KIBANA_URL=https://kibana.example.internal:5601
KIBANA_API_KEY=REPLACE_WITH_READ_ONLY_KIBANA_API_KEY
KIBANA_SPACE_ID=

OLLAMA_MODEL=qwen3:8b-q4_K_M
INVESTIGATOR_SENSITIVE_FIELDS=customer.national_id,national_id,account.number,account_number,card.number
